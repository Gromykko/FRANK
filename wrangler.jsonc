{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "frank-forecast",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "preview_urls": false,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1
    }
  },
  "secrets": {
    "required": ["FRANK_WARM_TOKEN"]
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "FRANK_FORECAST_CACHE",
      "id": "dd68c9d4ad3a4d35ab288ff764bfea25"
    }
  ]
}
