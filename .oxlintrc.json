{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "jsx-a11y"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "jsx-a11y/prefer-tag-over-role": "off", // custom APG widgets; native tags cannot carry these patterns
    "jsx-a11y/interactive-supports-focus": "off", // roving tabindex lives on the children, not the container
    "jsx-a11y/no-static-element-interactions": "off" // pointer-only drag-scroll and backdrops
  }
}
