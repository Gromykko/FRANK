{
  "name": "frank",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:e2e:install": "playwright install chromium",
    "test:e2e": "npm run build && playwright test",
    "worker:types": "wrangler types worker-configuration.d.ts --config wrangler.jsonc",
    "worker:types:check": "wrangler types worker-configuration.d.ts --config wrangler.jsonc --check",
    "worker:typecheck": "tsc --project tsconfig.worker.json && tsc --project tests/worker-runtime/tsconfig.json",
    "worker:deploy": "wrangler deploy",
    "worker:dry-run": "wrangler deploy --dry-run",
    "worker:dev": "wrangler dev",
    "worker:gc-kv": "node scripts/gc-worker-kv.mjs",
    "release:check-contract": "node scripts/check-release-contract.mjs",
    "release:record-model": "node scripts/forecast-model-contract.mjs",
    "worker:tail": "wrangler tail frank-forecast",
    "test:worker-runtime": "vitest run --config vitest.worker.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "lucide-react": "^1.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "playwright": "^1.61.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "wrangler": "4.124.0"
  }
}
